---
import { count, eq } from "drizzle-orm";
import Base from "../layouts/Base.astro";
import { db } from "../lib/db";
import { forms } from "../lib/schema";

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect("/auth/login?return=/new");
}

const MAX_FORMS = 3;
const eligible = import.meta.env.DEV || user.isAllowed;
const formCount =
	(
		await db
			.select({ value: count() })
			.from(forms)
			.where(eq(forms.creatorId, user.id))
			.get()
	)?.value ?? 0;
const canCreate = eligible && formCount < MAX_FORMS;

const error = Astro.url.searchParams.get("error");
---

<Base title="New Form - RSVP">
  <div class="max-w-lg mx-auto space-y-8">
    <div>
      <a href="/" class="text-sm text-zinc-500 hover:text-zinc-300 transition-colors">Back</a>
      <h1 class="text-2xl font-bold tracking-tight mt-4">Create a new form</h1>
      <p class="text-zinc-500 text-sm mt-1">Set up an RSVP form and share the link.</p>
    </div>

    {!eligible && (
      <div class="bg-zinc-900/50 border border-zinc-800/60 rounded-xl px-4 py-3 text-sm text-zinc-500">
        Your account is not eligible for YSWS programs. You cannot create forms.
      </div>
    )}

    {eligible && formCount >= MAX_FORMS && (
      <div class="bg-zinc-900/50 border border-zinc-800/60 rounded-xl px-4 py-3 text-sm text-zinc-500">
        You've reached the limit of {MAX_FORMS} forms. Delete an existing one to create a new one.
      </div>
    )}

    {error && (
      <div class="bg-red-950/30 border border-red-900/30 text-red-400 rounded-xl px-4 py-3 text-sm">
        {error}
      </div>
    )}

    <form method="POST" action="/api/form" class="space-y-6">
      <div class="space-y-1.5">
        <label for="title" class="block text-sm font-medium text-zinc-300">Title</label>
        <input
          type="text"
          id="title"
          name="title"
          required
          disabled={!canCreate}
          class="w-full bg-zinc-900/50 border border-zinc-800/60 rounded-xl px-4 py-3 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all disabled:opacity-50"
          placeholder="My event"
        />
      </div>

      <div class="space-y-1.5">
        <label for="slug" class="block text-sm font-medium text-zinc-300">URL</label>
        <div class="flex items-center gap-1">
          <span class="text-zinc-600 text-sm shrink-0">/</span>
          <input
            type="text"
            id="slug"
            name="slug"
            required
            pattern="[a-z0-9\-]+"
            disabled={!canCreate}
            class="w-full bg-zinc-900/50 border border-zinc-800/60 rounded-xl px-4 py-3 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all disabled:opacity-50"
            placeholder="my-event"
          />
        </div>
        <p class="text-xs text-zinc-600">Lowercase letters, numbers, and hyphens only.</p>
      </div>

      <div class="space-y-1.5">
        <label for="description" class="block text-sm font-medium text-zinc-300">
          Description <span class="text-zinc-600">(optional)</span>
        </label>
        <textarea
          id="description"
          name="description"
          rows="3"
          disabled={!canCreate}
          class="w-full bg-zinc-900/50 border border-zinc-800/60 rounded-xl px-4 py-3 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all resize-none disabled:opacity-50"
          placeholder="What is this for?"
        ></textarea>
      </div>

      <div class="space-y-1.5">
        <label for="website" class="block text-sm font-medium text-zinc-300">
          Website <span class="text-zinc-600">(optional)</span>
        </label>
        <input
          type="url"
          id="website"
          name="website"
          disabled={!canCreate}
          class="w-full bg-zinc-900/50 border border-zinc-800/60 rounded-xl px-4 py-3 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all disabled:opacity-50"
          placeholder="https://example.com"
        />
        <p class="text-xs text-zinc-600">A link shown on the RSVP page.</p>
      </div>

      <div class="space-y-1.5">
        <label for="slackChannelId" class="block text-sm font-medium text-zinc-300">
          Slack channel ID <span class="text-zinc-600">(optional)</span>
        </label>
        <input
          type="text"
          id="slackChannelId"
          name="slackChannelId"
          disabled={!canCreate}
          class="w-full bg-zinc-900/50 border border-zinc-800/60 rounded-xl px-4 py-3 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all disabled:opacity-50"
          placeholder="C0123456789"
          pattern="[A-Z][A-Z0-9]{6,12}"
          title="Slack channel ID (e.g. C0123456789)"
        />
        <p class="text-xs text-zinc-600">People who RSVP will be invited to this Slack channel.</p>
      </div>

      <label class="flex items-center gap-3 cursor-pointer select-none">
        <input
          type="checkbox"
          name="feedbackEnabled"
          disabled={!canCreate}
          class="rounded border-zinc-700 bg-zinc-900 text-primary focus:ring-0 focus:ring-offset-0"
        />
        <span class="text-sm text-zinc-300">Enable feedback from attendees</span>
      </label>

      <button
        type="submit"
        disabled={!canCreate}
        class:list={[
          'w-full px-6 py-3.5 rounded-xl transition-all font-medium',
          canCreate
            ? 'bg-primary text-white hover:bg-primary-dark shadow-lg shadow-primary/20 hover:shadow-primary/30 active:scale-[0.98]'
            : 'bg-zinc-800 text-zinc-600 cursor-not-allowed',
        ]}
      >
        Create form
      </button>
    </form>
  </div>
</Base>

<dialog id="confirm-dialog" class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 m-0 bg-zinc-900 border border-zinc-800 rounded-2xl p-6 max-w-sm w-full backdrop:bg-black/60 backdrop:backdrop-blur-sm">
  <h2 class="text-base font-semibold text-zinc-100 mb-2">Before you create</h2>
  <p class="text-sm text-zinc-400 mb-1">
    The URL and name <span class="text-zinc-200 font-medium">cannot be changed</span> after creation.
  </p>
  <ul class="text-sm text-zinc-500 mt-3 mb-5 space-y-1">
    <li>Name: <span id="preview-title" class="text-zinc-300 font-medium"></span></li>
    <li>URL: <span class="text-zinc-600">/</span><span id="preview-slug" class="text-zinc-300 font-mono"></span></li>
  </ul>
  <div class="flex gap-3">
    <button
      id="dialog-cancel"
      type="button"
      class="flex-1 px-4 py-2.5 rounded-xl bg-zinc-800 text-zinc-300 hover:bg-zinc-700 transition-colors text-sm font-medium"
    >
      Cancel
    </button>
    <button
      id="dialog-confirm"
      type="button"
      class="flex-1 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-primary-dark transition-colors text-sm font-medium shadow-lg shadow-primary/20"
    >
      Create form
    </button>
  </div>
</dialog>

<script>
  const form = document.querySelector('form[action="/api/form"]') as HTMLFormElement;
  const dialog = document.getElementById('confirm-dialog') as HTMLDialogElement;
  const previewTitle = document.getElementById('preview-title')!;
  const previewSlug = document.getElementById('preview-slug')!;
  const cancelBtn = document.getElementById('dialog-cancel')!;
  const confirmBtn = document.getElementById('dialog-confirm')!;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const title = (document.getElementById('title') as HTMLInputElement).value.trim();
    const slug = (document.getElementById('slug') as HTMLInputElement).value.trim();
    previewTitle.textContent = title;
    previewSlug.textContent = slug;
    dialog.showModal();
  });

  cancelBtn.addEventListener('click', () => dialog.close());

  confirmBtn.addEventListener('click', () => {
    dialog.close();
    form.submit();
  });
</script>
